{
  "name": "onyx-mobile-manager",
  "version": "1.0.0",
  "core": {
    "display_name": "Onyx Mobile Manager",
    "description": "Gestion et configuration de telephones/tablettes Android pour Onyx: VPN, APK, ADB, historique",
    "status": "dev",
    "category": "infrastructure",
    "brain_area": "cerebellum",
    "tags": [
      "mobile",
      "device-management",
      "android",
      "vpn",
      "adb",
      "apk"
    ],
    "routing": {
      "host": "0.0.0.0",
      "port": 8095,
      "protocol": "http"
    },
    "api": {
      "base_path": "/api",
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/devices",
          "description": "Liste tous les appareils"
        },
        {
          "method": "POST",
          "path": "/api/devices",
          "description": "Enregistrer un appareil"
        },
        {
          "method": "PUT",
          "path": "/api/devices/{id}",
          "description": "Modifier un appareil"
        },
        {
          "method": "DELETE",
          "path": "/api/devices/{id}",
          "description": "Supprimer un appareil"
        },
        {
          "method": "PATCH",
          "path": "/api/devices/{id}/status",
          "description": "Mettre a jour le statut"
        },
        {
          "method": "GET",
          "path": "/api/history",
          "description": "Historique complet"
        },
        {
          "method": "GET",
          "path": "/api/history/{device_id}",
          "description": "Historique d'un appareil"
        },
        {
          "method": "POST",
          "path": "/api/history",
          "description": "Logger une action"
        },
        {
          "method": "GET",
          "path": "/api/history/export",
          "description": "Export CSV/JSON"
        },
        {
          "method": "GET",
          "path": "/api/apk",
          "description": "Liste APKs disponibles"
        },
        {
          "method": "POST",
          "path": "/api/apk/upload",
          "description": "Upload un APK"
        },
        {
          "method": "GET",
          "path": "/api/apk/{name}/download",
          "description": "Download APK"
        },
        {
          "method": "DELETE",
          "path": "/api/apk/{name}",
          "description": "Supprimer un APK"
        }
      ]
    }
  },
  "heart": {
    "deployment": {
      "target_host": "10.0.0.44",
      "target_name": "OnyxSoma",
      "platform": "linux"
    },
    "lifecycle": {
      "run_mode": "service",
      "start_command": "python -m src.main",
      "restart_policy": "on-failure"
    },
    "systemd": {
      "enabled": true,
      "service_name": "onyx-mobile-manager",
      "user": "onyx",
      "working_directory": "/opt/onyx/skills/onyx-mobile-manager",
      "exec_start": "/opt/onyx/venv/bin/python -m src.main",
      "environment": {
        "SKILL_PORT": "8095"
      }
    },
    "health": {
      "endpoint": "/health",
      "interval": 30
    }
  },
  "forge": {
    "type": "python",
    "development": {
      "dev_platform": "dendrite",
      "test_platform": "dendrite",
      "remote_mount": false,
      "dev_status": "production-ready",
      "progress_percent": 100
    },
    "python": {
      "src_dir": "src",
      "entry_point": "main.py"
    },
    "repository": "VersoVet/onyx-mobile-manager"
  },
  "dashboard": {
    "enabled": true,
    "page": "/",
    "icon": "smartphone",
    "category": "infrastructure",
    "color": "#4CAF50"
  },
  "integration": {
    "redis": {
      "publish_status": true,
      "channel": "onyx:skill:status"
    },
    "sdk": {
      "min_version": "2.1.0"
    }
  }
}